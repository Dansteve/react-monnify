{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "react",
    "rootDir": "./libs",
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "sourceMap": true,
    "importHelpers": true,
    "isolatedModules": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "types": ["jest", "node", "@testing-library/jest-dom"]
  },
  // Tests are included so `npm run typecheck` and the editor cover them too.
  // They are kept out of the published bundle by the rollup plugin's `exclude`.
  "include": ["libs"],
  "exclude": ["node_modules", "dist", "example"]
}
