# Copy to .env and fill in your own credentials from the Monnify dashboard.
#
# Never put your Secret Key here. It is a server-side credential; anything in a
# VITE_-prefixed variable is compiled into the browser bundle and is public.
VITE_MONNIFY_API_KEY=MK_TEST_XXXXXXXXXX
VITE_MONNIFY_CONTRACT_CODE=0000000000
